# Copy to .env on the server and fill in. Never commit .env.
AIRLABS_API_KEY=
# Shared secret the app must send as X-Airadar-Token
APP_TOKEN=change-me

# Sign in with Google: the *Web* OAuth client ID from console.cloud.google.com
GOOGLE_CLIENT_ID=
# Long random string used to sign access tokens (e.g. python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET=

# Left as is when using the bundled Mongo container
MONGO_URL=mongodb://mongo:27017
MONGO_DB=airadar

# --- HTTPS (optional, needs a domain pointing at this server) --------------------
# The public address links should use, e.g. https://airadar.example.com
PUBLIC_URL=
# For Caddy: the domain to get a certificate for (leave empty to stay on plain HTTP :8080)
DOMAIN=
# For Android App Links: SHA-256 of your signing certificates, comma-separated
# (Android Studio > Gradle > signingReport, or: keytool -list -v -keystore ...)
ANDROID_SHA256_CERTS=

# --- Stripe (plans are sold on /pay; tokens are redeemed in the app) ------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs of the two monthly subscriptions, from the Stripe dashboard
STRIPE_PRICE_SUPERIOR=
STRIPE_PRICE_PREMIUM=
