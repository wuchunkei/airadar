# Copy to .env on the server and fill in. Never commit .env.
AIRLABS_API_KEY=
# Shared secret the app must send as X-Airadar-Token
APP_TOKEN=change-me

# Sign in with Google: the *Web* OAuth client ID from console.cloud.google.com
GOOGLE_CLIENT_ID=
# Long random string used to sign access tokens (e.g. python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET=

# Left as is when using the bundled Mongo container
MONGO_URL=mongodb://mongo:27017
MONGO_DB=airadar
