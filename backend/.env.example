# Copy to .env on the server and fill in. Never commit .env.
AIRLABS_API_KEY=
# Fallback when AirLabs has nothing for a flight number at all (a coverage
# gap, not always a dead one) — RapidAPI → AeroDataBox, free tier 400 "API
# units"/month, 2 spent per lookup here. Optional: without it, that case just
# falls back to AirLabs' own (adsbdb-enriched) error message as before.
# The iOS app carries its own copy of this same kind of key for a different
# purpose; reusing that value here shares its monthly quota with it — a
# second free RapidAPI key keeps the two budgets apart.
AERODATABOX_KEY=

# Volcengine Ark (火山方舟) -- a web-search-capable LLM used ONLY as a
# manually-triggered research assistant (see app/ark.py): a route's
# historical delay reputation, and real historical weather at departure/
# arrival. Never a source of truth for a flight's own facts, and not
# wired into the automatic search/scoring pipeline. ARK_MODEL must be a
# model or Bot endpoint id that actually has the web-search plugin
# attached (console.volcengine.com > Ark) -- a bare model id has no
# internet access, so there is no working default to fall back to.
ARK_API_KEY=
ARK_MODEL=

# Shared secret the app must send as X-Airadar-Token
APP_TOKEN=change-me

# Sign in with Google: the *Web* OAuth client ID from console.cloud.google.com
# Also used by /confirm_feed's own Sign in with Google button — that page's
# real origin (e.g. https://airadar.example.com) needs to be added to this
# same client's Authorized JavaScript origins in Cloud Console.
GOOGLE_CLIENT_ID=
# Long random string used to sign access tokens (e.g. python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET=

# Whoever signs in at /confirm_feed with this exact email (case-insensitive)
# can review fed flights the community couldn't settle — everyone else gets
# a 403. Your own Google account's address.
ADMIN_EMAIL=

# Left as is when using the bundled Mongo container
MONGO_URL=mongodb://mongo:27017
MONGO_DB=airadar

# --- HTTPS (optional, needs a domain pointing at this server) --------------------
# The public address links should use, e.g. https://airadar.example.com
PUBLIC_URL=
# For Caddy: the domain to get a certificate for (leave empty to stay on plain HTTP :8080)
DOMAIN=
# For Android App Links: SHA-256 of your signing certificates, comma-separated
# (Android Studio > Gradle > signingReport, or: keytool -list -v -keystore ...)
ANDROID_SHA256_CERTS=

# --- Stripe (plans are sold on /pay; tokens are redeemed in the app) ------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs of the two monthly subscriptions, from the Stripe dashboard
STRIPE_PRICE_SUPERIOR=
STRIPE_PRICE_PREMIUM=

# Tokens that are Premium forever, comma-separated (testing, your own phone).
LIFETIME_PREMIUM_TOKENS=
