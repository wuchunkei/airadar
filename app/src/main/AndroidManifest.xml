<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Airadar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Airadar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Shared trip links: airadar://s/<token> -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="airadar" android:host="s" />
            </intent-filter>
            <!-- And https://<link.host>/s/<token> once the server has a domain and TLS -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="${linkHost}" android:pathPrefix="/s/" />
            </intent-filter>
        </activity>

        <!-- The Home Screen icon follows the traveller's tier: TierIconManager
             enables exactly one of these (or none, for Black Iron, the default
             icon above) whenever FlightStore's own tierStanding changes. Each
             targets MainActivity itself; only the launcher icon differs. -->
        <activity-alias
            android:name=".TierIconBronze"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_tier_bronze"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".TierIconSilver"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_tier_silver"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".TierIconGold"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_tier_gold"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".TierIconPlatinum"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_tier_platinum"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".TierIconDiamond"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_tier_diamond"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".TierIconRuby"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_tier_ruby"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".TierIconObsidian"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_tier_obsidian"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".TierIconRainbow"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_tier_rainbow"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

    </application>

</manifest>
